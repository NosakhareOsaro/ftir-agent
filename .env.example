# Free key, no card: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Seconds between LLM requests; raise it if you hit 429s on the free tier
LLM_MIN_INTERVAL=13
LLM_TEMPERATURE=0
# Optional: a cheaper/higher-quota model for the eval judge
# JUDGE_MODEL=

# OpenAI (paid, ~$0.13 per full eval run):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6-luna
# LLM_MIN_INTERVAL=1
# LLM_REASONING_EFFORT=none
# (leave LLM_TEMPERATURE unset: this model only accepts its default)

# Local alternative (Ollama), no key needed:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MIN_INTERVAL=0

# Optional, NCBI: email they can contact about heavy use; key raises rate limit
NCBI_EMAIL=
NCBI_API_KEY=
